<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/namedfilter_box"
    android:layout_width="fill_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:visibility="gone">

    <View
        style="@style/separator_horizontal"
        android:layout_marginBottom="9dp"
        android:layout_marginTop="9dp" />

    <TextView
        android:id="@+id/namedfilter_text"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="left"
        android:layout_marginLeft="6dip"
        android:layout_marginRight="6dip"
        android:paddingRight="3dip"
        android:drawableStart="@drawable/ic_menu_filter"
        android:drawableTint="@color/colorText"
        android:drawablePadding="6dp"
        android:gravity="center_vertical"
        android:textSize="@dimen/textSize_detailsSecondary"
        android:textColor="@color/colorText"
        android:textIsSelectable="false"
        tools:text="🔵 Active Filter&#10;Inactive Filter" />

</LinearLayout>
