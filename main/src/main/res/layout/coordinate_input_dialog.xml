<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <include
        android:id="@+id/actionbar"
        layout="@layout/actionbar_popup" />

    <Spinner
        android:id="@+id/dialogSpinner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="8dp" />

    <cgeo.geocaching.ui.NotifyOnTouchOutsideElement
        android:id="@+id/touch_interceptor"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="8dp"
            android:background="@drawable/border_active"
            android:orientation="vertical"
            android:padding="8dp">

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/latitudeFrame"
                style="@style/textinput_edittext_singleline">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/latitude"
                    style="@style/textinput_embedded_singleline"
                    android:hint="@string/latitude"
                    android:inputType="textNoSuggestions" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/longitudeFrame"
                style="@style/textinput_edittext_singleline">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/longitude"
                    style="@style/textinput_embedded_singleline"
                    android:hint="@string/longitude"
                    android:inputType="textNoSuggestions" />
            </com.google.android.material.textfield.TextInputLayout>

            <LinearLayout
                android:id="@+id/configurableLatitude"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginRight="8dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/hemisphereLatitude"
                    style="@style/button_letter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textSize="@dimen/textSize_inputCoords" />

                <EditText
                    android:id="@+id/editTextLatDegrees"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_weight="3"
                    android:gravity="right"
                    android:hint="@string/cc_hint_degrees"
                    android:inputType="number"
                    android:maxLength="2"
                    android:selectAllOnFocus="true" />

                <TextView
                    android:id="@+id/txtLatSymbol1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_weight="0.5"
                    android:text="@string/hash_symbol"
                    android:textSize="@dimen/textSize_inputCoords"
                    tools:ignore="HardcodedText" />

                <EditText
                    android:id="@+id/editTextLatMinutes"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_weight="3"
                    android:gravity="right"
                    android:hint="@string/cc_hint_minutes"
                    android:inputType="number"
                    android:maxLength="2"
                    android:selectAllOnFocus="true" />

                <TextView
                    android:id="@+id/txtLatSymbol2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_weight="0.5"
                    android:text="@string/hash_symbol"
                    android:textSize="@dimen/textSize_inputCoords"
                    tools:ignore="HardcodedText" />

                <EditText
                    android:id="@+id/editTextLatSeconds"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_weight="3"
                    android:gravity="right"
                    android:hint="@string/cc_hint_seconds"
                    android:inputType="number"
                    android:maxLength="2"
                    android:selectAllOnFocus="true" />

                <TextView
                    android:id="@+id/txtLatSymbol3"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_weight="0.5"
                    android:text="@string/hash_symbol"
                    android:textSize="@dimen/textSize_inputCoords"
                    tools:ignore="HardcodedText" />

                <EditText
                    android:id="@+id/editTextLatFraction"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_weight="4"
                    android:gravity="left"
                    android:hint="@string/cc_hint_fraction"
                    android:inputType="number"
                    android:maxLength="5"
                    android:selectAllOnFocus="true" />

                <TextView
                    android:id="@+id/txtLatSymbol4"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_weight="0.5"
                    android:text="@string/hash_symbol"
                    android:textSize="@dimen/textSize_inputCoords"
                    tools:ignore="HardcodedText" />


            </LinearLayout>

            <LinearLayout
                android:id="@+id/configurableLongitude"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginRight="8dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/hemisphereLongitude"
                    style="@style/button_letter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textSize="@dimen/textSize_inputCoords" />

                <EditText
                    android:id="@+id/editTextLonDegrees"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_weight="3"
                    android:gravity="right"
                    android:hint="@string/cc_hint_degrees"
                    android:inputType="number"
                    android:maxLength="3"
                    android:selectAllOnFocus="true" />

                <TextView
                    android:id="@+id/txtLonSymbol1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_weight="0.5"
                    android:text="@string/hash_symbol"
                    android:textSize="@dimen/textSize_inputCoords"
                    tools:ignore="HardcodedText" />

                <EditText
                    android:id="@+id/editTextLonMinutes"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_weight="3"
                    android:gravity="right"
                    android:hint="@string/cc_hint_minutes"
                    android:inputType="number"
                    android:maxLength="2"
                    android:selectAllOnFocus="true" />

                <TextView
                    android:id="@+id/txtLonSymbol2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_weight="0.5"
                    android:text="@string/hash_symbol"
                    android:textSize="@dimen/textSize_inputCoords"
                    tools:ignore="HardcodedText" />

                <EditText
                    android:id="@+id/editTextLonSeconds"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_weight="3"
                    android:gravity="right"
                    android:hint="@string/cc_hint_seconds"
                    android:inputType="number"
                    android:maxLength="2"
                    android:selectAllOnFocus="true" />

                <TextView
                    android:id="@+id/txtLonSymbol3"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_weight="0.5"
                    android:text="@string/hash_symbol"
                    android:textSize="@dimen/textSize_inputCoords"
                    tools:ignore="HardcodedText" />

                <EditText
                    android:id="@+id/editTextLonFraction"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_weight="4"
                    android:gravity="left"
                    android:hint="@string/cc_hint_fraction"
                    android:inputType="number"
                    android:maxLength="5"
                    android:selectAllOnFocus="true" />

                <TextView
                    android:id="@+id/txtLonSymbol4"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_weight="0.5"
                    android:text="@string/hash_symbol"
                    android:textSize="@dimen/textSize_inputCoords"
                    tools:ignore="HardcodedText" />

            </LinearLayout>

        </LinearLayout>

        <Button
            android:id="@+id/current"
            style="@style/button_full"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:text="@string/waypoint_my_coordinates" />

        <FrameLayout
            android:id="@+id/averaging_placeholder"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <Button
            android:id="@+id/cache"
            style="@style/button_full"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:text="@string/waypoint_cache_coordinates" />

        <Button
            android:id="@+id/calculate"
            style="@style/button_full"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:text="@string/waypoint_calculated_coordinates_global"
            app:icon="@drawable/ic_menu_variable" />

        <Button
            android:id="@+id/map"
            style="@style/button_full"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:text="@string/waypoint_select_from_map"
            app:icon="@drawable/sc_icon_map" />


        <Button
            android:id="@+id/clipboard"
            style="@style/button_full"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:text="@string/from_clipboard" />

        <Button
            android:id="@+id/clear"
            style="@style/button_full"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:text="@string/waypoint_clear_coordinates" />

    </cgeo.geocaching.ui.NotifyOnTouchOutsideElement>
</LinearLayout>
