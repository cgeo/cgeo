<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <View
        style="@style/separator_horizontal"
        android:layout_marginTop="1dp" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/log_template_list"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <TextView
        android:id="@+id/empty_hint"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:visibility="gone"
        android:text="@string/init_log_templates_none"
        android:textSize="@dimen/textSize_listsPrimary"
        android:textColor="@color/colorText_listsSecondary" />

    <Button
        android:id="@+id/add_template"
        style="@style/button_full"
        android:layout_marginTop="5dp"
        android:text="@string/init_log_template_addnew" />

</LinearLayout>
